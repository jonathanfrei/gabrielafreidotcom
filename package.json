{
  "name": "gabrielafreidotcom",
  "private": true,
  "description": "Gabriela Frei — Jekyll site lint/format tooling (vanilla JS + SCSS)",
  "type": "module",
  "scripts": {
    "lint": "npm run lint:js && npm run lint:css && npm run format:check",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"_sass/**/*.{css,scss}\" --allow-empty-input",
    "format": "prettier --write \"*.{js,json,md,yml,yaml}\" \"assets/**/*.{js,css,scss}\" \"_sass/**/*.{scss,css}\" \".github/**/*.{yml,yaml,md}\" \".vscode/*.json\"",
    "format:check": "prettier --check \"*.{js,json,md,yml,yaml}\" \"assets/**/*.{js,css,scss}\" \"_sass/**/*.{scss,css}\" \".github/**/*.{yml,yaml,md}\" \".vscode/*.json\""
  },
  "devDependencies": {
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "stylelint": "^16.12.0",
    "stylelint-config-standard-scss": "^14.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
